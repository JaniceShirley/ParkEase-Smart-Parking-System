# ParkEase - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT commit .env containing real credentials to version control.

# Application Environment: 'production' (the default when unset) or 'development'.
# For local work on your own machine, change this to APP_ENV=development.
# ('testing' is reserved for the pytest suite; Gunicorn always requires 'production'.)
APP_ENV=production

# Flask Secret Key
# Required in production: at least 32 characters and not a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# With APP_ENV=development it may be left empty: a random key is generated per
# process (sessions are then lost on restart).
FLASK_SECRET_KEY=

# Interactive debugger. FLASK_DEBUG=true, `flask --debug` and `flask run --debugger`
# are refused unless APP_ENV=development.
FLASK_DEBUG=false

# Database and Model Configuration
# instance/ is git-ignored; the database is created automatically on first start.
# The legacy parking.db location in the repository folder is refused.
DATABASE_PATH=instance/parking.db
MODEL_PATH=price_prediction_model.pkl
PARKING_CAPACITY=100

# OpenWeatherMap API Integration (optional; weather defaults to 'average' without it)
# Sign up and obtain an API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Administrator Registration Passcode
# Leave empty to disable /admin_signup (recommended once your administrators exist).
# When set, it must be at least 12 characters and not a published default.
# Administrators can always be created from the command line:
#   flask --app app create-admin
ADMIN_SIGNUP_PASSCODE=

# Rate limiting (Flask-Limiter syntax, e.g. "5 per minute;20 per hour" or "3/minute").
# Values are validated at startup: a malformed value or a zero limit stops the app
# instead of silently disabling rate limiting. Leave empty to use the defaults below.
# The in-memory store is per process; use a shared store such as
# redis://localhost:6379 when running several workers.
LOGIN_RATE_LIMIT=5 per minute;20 per hour
SIGNUP_RATE_LIMIT=5 per hour
RATELIMIT_STORAGE_URI=memory://

# Send session cookies over HTTPS only. Defaults to true when APP_ENV=production.
# SESSION_COOKIE_SECURE=true

# Number of reverse proxies in front of the app whose X-Forwarded-For /
# X-Forwarded-Proto headers are trusted (whole number 0-5). It MUST equal the
# real number of proxies (e.g. 1 for a single nginx that appends the client IP).
# A higher value lets clients forge their IP address and evade rate limits.
# Leave 0 when clients connect directly.
TRUSTED_PROXY_COUNT=0
