# ParkEase - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT commit .env containing real credentials to version control.

# Application Environment ('development' or 'production')
APP_ENV=development

# Flask Secret Key (In production, must be set to a secure, random string)
FLASK_SECRET_KEY=replace_with_a_secure_random_key_in_production
FLASK_DEBUG=False

# Database and Model Configuration
DATABASE_PATH=parking.db
MODEL_PATH=price_prediction_model.pkl

# OpenWeatherMap API Integration
# Sign up and obtain an API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Administrator Registration Passcode
ADMIN_SIGNUP_PASSCODE=your_organization_signup_passcode_here
